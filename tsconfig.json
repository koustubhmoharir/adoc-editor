{
    "compilerOptions": {
        "target": "es2024",
        "useDefineForClassFields": true,
        "lib": [
            "ES2024",
            "DOM",
            "DOM.Iterable",
            "ESNext.Iterator",
            "ESNext.Collection"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowJs": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "types": [
            "node",
            "wicg-file-system-access"
        ]
    },
    "include": [
        "src",
        "tests"
    ]
}