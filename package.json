{
    "name": "adoc-editor",
    "version": "1.0.0",
    "description": "ADoc Editor with Monaco and MobX",
    "type": "module",
    "scripts": {
        "start": "node scripts/build.ts --serve --watch --show-tokens",
        "serve": "cross-env PORT=8001 node scripts/build.ts --serve --watch-dirty",
        "rebuild": "cross-env PORT=8001 node scripts/verify_rebuild.ts",
        "build": "node scripts/build.ts",
        "test": "cross-env PORT=8001 node scripts/test_debug.ts",
        "lint": "tsc --noEmit",
        "coverage": "c8 --reporter=lcov --reporter=text --reporter=json-summary npm run test"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-crypto/sha256-browser": "^5.2.0",
        "@aws-sdk/client-cognito-identity": "^3.971.0",
        "@aws-sdk/client-s3": "^3.971.0",
        "@aws-sdk/credential-provider-cognito-identity": "^3.971.0",
        "@fortawesome/fontawesome-free": "^7.1.0",
        "@vanilla-extract/esbuild-plugin": "^2.3.21",
        "fzf": "^0.5.2",
        "idb-keyval": "^6.2.2",
        "mobx": "^6.10.0",
        "mobx-react-lite": "^4.0.0",
        "monaco-editor": "^0.45.0",
        "oidc-client-ts": "^3.4.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "smol-toml": "^1.6.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@types/node": "^25.0.3",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/wicg-file-system-access": "^2023.10.7",
        "@vanilla-extract/css": "^1.18.0",
        "asciidoctor": "^3.0.4",
        "c8": "^10.1.3",
        "cross-env": "^10.1.0",
        "esbuild": "^0.27.2",
        "typescript": "^5.3.0"
    }
}