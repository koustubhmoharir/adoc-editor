{
    "name": "adoc-editor",
    "version": "1.0.0",
    "description": "ADoc Editor with Monaco and MobX",
    "type": "module",
    "scripts": {
        "preinstall": "pnpx only-allow pnpm",
        "start": "node scripts/build.ts --serve --watch --show-tokens",
        "serve": "cross-env PORT=8001 node scripts/build.ts --serve --watch-dirty",
        "rebuild": "cross-env PORT=8001 node scripts/verify_rebuild.ts",
        "build": "node scripts/build.ts",
        "test": "cross-env PORT=8001 node scripts/test_debug.ts",
        "lint": "tsc --noEmit",
        "coverage": "c8 --reporter=lcov --reporter=text --reporter=json-summary pnpm run test"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-crypto/sha256-browser": "^5.2.0",
        "@aws-sdk/client-s3": "^3.1156.0",
        "@aws-sdk/credential-provider-cognito-identity": "^3.972.75",
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@vanilla-extract/esbuild-plugin": "^2.3.22",
        "fzf": "^0.5.2",
        "idb-keyval": "^6.3.0",
        "ignore": "^7.0.14",
        "mobx": "^7.1.1",
        "mobx-react-lite": "^5.1.0",
        "monaco-editor": "^0.57.0",
        "oidc-client-ts": "^3.5.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "smol-toml": "^1.9.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/wicg-file-system-access": "^2023.10.7",
        "@vanilla-extract/css": "^1.21.3",
        "asciidoctor": "^4.1.1",
        "c8": "^12.0.0",
        "cross-env": "^10.1.0",
        "esbuild": "^0.28.2",
        "typescript": "^7.0.2"
    }
}